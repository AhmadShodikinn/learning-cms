---
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";

interface Props {
  title?: string;
}

const { title = "Admin" } = Astro.props;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="color-scheme" content="light dark" />

    <!--
      Apply theme before page is painted.
      This prevents light → dark flashing.
    -->
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem("theme");

          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;

          const theme =
            storedTheme === "dark" || storedTheme === "light"
              ? storedTheme
              : prefersDark
                ? "dark"
                : "light";

          const root = document.documentElement;

          root.dataset.theme = theme;

          root.classList.toggle("dark", theme === "dark");

          root.style.colorScheme = theme;
        } catch {}
      })();
    </script>
  </head>

  <body class="admin-body">
    <div class="admin-layout">
      <!-- =========================
           SIDEBAR
      ========================== -->

      <aside class="admin-sidebar">
        <div class="sidebar-top">
          <!-- BRAND -->

          <a href="/admin/modules" class="admin-brand">
            <div class="admin-brand-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>

                <path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"
                ></path>

                <path d="m10 8 4 2.5-4 2.5Z"></path>
              </svg>
            </div>

            <div class="admin-brand-content">
              <strong> Learning Modules </strong>

              <span> Admin </span>
            </div>
          </a>

          <!-- NAVIGATION -->

          <nav class="admin-nav">
            <a
              href="/admin/modules"
              class:list={[
                "admin-nav-item",
                {
                  active: isActive("/admin/modules"),
                },
              ]}
            >
              <span class="nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" rx="1"></rect>

                  <rect x="14" y="3" width="7" height="7" rx="1"></rect>

                  <rect x="3" y="14" width="7" height="7" rx="1"></rect>

                  <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                </svg>
              </span>

              <span> Modules </span>
            </a>
          </nav>
        </div>

        <!-- SIDEBAR BOTTOM -->

        <div class="sidebar-bottom">
          <a href="/" class="back-website">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5"></path>

                <path d="m12 19-7-7 7-7"></path>
              </svg>
            </span>

            <span> Kembali ke Website </span>
          </a>
        </div>
      </aside>

      <!-- =========================
           MAIN
      ========================== -->

      <div class="admin-main">
        <header class="admin-header">
          <div class="admin-header-title">
            <h1>
              {title}
            </h1>

            <p id="admin-user">Checking session...</p>
          </div>

          <div class="admin-header-actions">
            <!-- THEME -->

            <button
              type="button"
              class="admin-theme-toggle"
              data-admin-theme-toggle
              title="Toggle theme"
              aria-label="Switch to dark theme"
              aria-pressed="false"
            >
              <IconMoon class="admin-theme-moon" />

              <IconSunHigh class="admin-theme-sun" />
            </button>

            <!-- LOGOUT -->

            <button id="logout-button" type="button" class="logout-button">
              Logout
            </button>
          </div>
        </header>

        <main class="admin-content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import { supabase } from "@/lib/supabase";

      /* =========================
         THEME
      ========================= */

      type Theme = "light" | "dark";

      const getStoredTheme = (): Theme | null => {
        try {
          const storedTheme = localStorage.getItem("theme");

          return storedTheme === "dark" || storedTheme === "light"
            ? storedTheme
            : null;
        } catch {
          return null;
        }
      };

      const getPreferredTheme = (): Theme => {
        return (
          getStoredTheme() ??
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light")
        );
      };

      const applyTheme = (theme: Theme, persist = false) => {
        const root = document.documentElement;

        const isDark = theme === "dark";

        root.dataset.theme = theme;

        root.classList.toggle("dark", isDark);

        root.style.colorScheme = theme;

        if (persist) {
          try {
            localStorage.setItem("theme", theme);
          } catch {}
        }

        document
          .querySelectorAll<HTMLButtonElement>("[data-admin-theme-toggle]")
          .forEach(button => {
            button.setAttribute("aria-pressed", String(isDark));

            button.setAttribute(
              "aria-label",
              isDark ? "Switch to light theme" : "Switch to dark theme"
            );

            button.setAttribute(
              "title",
              isDark ? "Switch to light theme" : "Switch to dark theme"
            );
          });
      };

      const setupTheme = () => {
        applyTheme(getPreferredTheme());

        document
          .querySelectorAll<HTMLButtonElement>("[data-admin-theme-toggle]")
          .forEach(button => {
            if (button.dataset.themeBound === "true") {
              return;
            }

            button.dataset.themeBound = "true";

            button.addEventListener("click", () => {
              const currentTheme = document.documentElement.classList.contains(
                "dark"
              )
                ? "dark"
                : "light";

              applyTheme(currentTheme === "dark" ? "light" : "dark", true);
            });
          });
      };

      setupTheme();

      document.addEventListener("astro:page-load", setupTheme);

      /* =========================
         SESSION
      ========================= */

      const userElement = document.getElementById("admin-user");

      const logoutButton = document.getElementById("logout-button");

      async function checkSession() {
        const {
          data: { session },
          error,
        } = await supabase.auth.getSession();

        if (error || !session) {
          window.location.href = "/admin/login";

          return;
        }

        if (userElement) {
          userElement.textContent = session.user.email ?? "";
        }
      }

      /* =========================
         LOGOUT
      ========================= */

      logoutButton?.addEventListener("click", async () => {
        if (logoutButton instanceof HTMLButtonElement) {
          logoutButton.disabled = true;

          logoutButton.textContent = "Logging out...";
        }

        const { error } = await supabase.auth.signOut();

        if (error) {
          if (logoutButton instanceof HTMLButtonElement) {
            logoutButton.disabled = false;

            logoutButton.textContent = "Logout";
          }

          return;
        }

        window.location.href = "/admin/login";
      });

      checkSession();
    </script>
  </body>
</html>

<style is:global>
  /* =========================
     RESET
  ========================= */

  * {
    box-sizing: border-box;
  }

  html {
    --admin-bg: #f7f8fa;

    --admin-surface: #ffffff;

    --admin-surface-muted: #fafafa;

    --admin-hover: #f3f4f6;

    --admin-text: #111827;

    --admin-text-soft: #374151;

    --admin-muted: #6b7280;

    --admin-subtle: #9ca3af;

    --admin-border: #e5e7eb;

    --admin-border-soft: #f0f1f3;

    --admin-primary: #2563eb;

    --admin-primary-hover: #1d4ed8;

    --admin-danger: #b91c1c;

    --admin-danger-bg: #fee2e2;

    --admin-shadow: rgba(17, 24, 39, 0.06);

    color-scheme: light;

    background: var(--admin-bg);
  }

  html.dark,
  html[data-theme="dark"] {
    --admin-bg: #111827;

    --admin-surface: #1f2937;

    --admin-surface-muted: #253244;

    --admin-hover: #2d3a4d;

    --admin-text: #f3f4f6;

    --admin-text-soft: #d1d5db;

    --admin-muted: #aeb8c5;

    --admin-subtle: #8792a2;

    --admin-border: #374151;

    --admin-border-soft: #2d3748;

    --admin-primary: #60a5fa;

    --admin-primary-hover: #93c5fd;

    --admin-danger: #fca5a5;

    --admin-danger-bg: rgba(239, 68, 68, 0.12);

    --admin-shadow: rgba(0, 0, 0, 0.2);

    color-scheme: dark;
  }

  html,
  body {
    min-height: 100%;
  }

  body.admin-body {
    margin: 0;

    background: var(--admin-bg);

    color: var(--admin-text-soft);

    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;

    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  button {
    color: inherit;
  }

  /* =========================
     LAYOUT
  ========================= */

  .admin-layout {
    display: flex;

    min-height: 100vh;

    background: var(--admin-bg);

    color: var(--admin-text-soft);

    transition: background-color 0.18s ease;
  }

  /* =========================
     SIDEBAR
  ========================= */

  .admin-sidebar {
    position: fixed;

    top: 0;
    bottom: 0;
    left: 0;

    z-index: 40;

    display: flex;

    width: 230px;

    flex-direction: column;

    justify-content: space-between;

    padding: 22px 16px 18px;

    border-right: 1px solid var(--admin-border);

    background: var(--admin-surface);

    transition:
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  .sidebar-top {
    min-width: 0;
  }

  /* =========================
     BRAND
  ========================= */

  .admin-brand {
    display: flex;

    align-items: center;

    gap: 11px;

    margin-bottom: 32px;

    padding: 3px 5px;

    color: inherit;

    text-decoration: none;
  }

  .admin-brand-icon {
    display: flex;

    width: 38px;

    height: 38px;

    flex-shrink: 0;

    align-items: center;

    justify-content: center;

    border: 1px solid var(--admin-border);

    border-radius: 9px;

    background: var(--admin-surface-muted);

    color: var(--admin-text-soft);

    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .admin-brand-icon svg {
    width: 19px;

    height: 19px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.7;

    stroke-linecap: round;

    stroke-linejoin: round;
  }

  .admin-brand-content {
    min-width: 0;
  }

  .admin-brand-content strong {
    display: block;

    overflow: hidden;

    color: var(--admin-text);

    font-size: 14px;

    font-weight: 650;

    line-height: 1.4;

    text-overflow: ellipsis;

    white-space: nowrap;
  }

  .admin-brand-content span {
    display: block;

    margin-top: 1px;

    color: var(--admin-subtle);

    font-size: 10px;

    font-weight: 600;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }

  /* =========================
     NAV
  ========================= */

  .admin-nav {
    display: flex;

    flex-direction: column;

    gap: 5px;
  }

  .admin-nav-item {
    display: flex;

    align-items: center;

    gap: 10px;

    min-height: 42px;

    padding: 9px 11px;

    border-radius: 7px;

    color: var(--admin-muted);

    font-size: 13px;

    font-weight: 500;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .admin-nav-item:hover {
    background: var(--admin-hover);

    color: var(--admin-text);
  }

  .admin-nav-item.active {
    background: var(--admin-hover);

    color: var(--admin-text);

    font-weight: 600;
  }

  .nav-icon {
    display: flex;

    width: 20px;

    height: 20px;

    flex-shrink: 0;

    align-items: center;

    justify-content: center;
  }

  .nav-icon svg {
    width: 18px;

    height: 18px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.7;

    stroke-linecap: round;

    stroke-linejoin: round;
  }

  /* =========================
     SIDEBAR BOTTOM
  ========================= */

  .sidebar-bottom {
    padding-top: 16px;

    border-top: 1px solid var(--admin-border-soft);
  }

  .back-website {
    display: flex;

    align-items: center;

    gap: 10px;

    min-height: 42px;

    padding: 9px 11px;

    border-radius: 7px;

    color: var(--admin-muted);

    font-size: 12px;

    font-weight: 500;

    text-decoration: none;

    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .back-website:hover {
    background: var(--admin-hover);

    color: var(--admin-text);
  }

  /* =========================
     MAIN
  ========================= */

  .admin-main {
    width: calc(100% - 230px);

    min-width: 0;

    margin-left: 230px;
  }

  /* =========================
     HEADER
  ========================= */

  .admin-header {
    display: flex;

    min-height: 76px;

    align-items: center;

    justify-content: space-between;

    gap: 24px;

    padding: 17px 32px;

    border-bottom: 1px solid var(--admin-border);

    background: var(--admin-surface);

    transition:
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  .admin-header-title {
    min-width: 0;
  }

  .admin-header h1 {
    margin: 0;

    color: var(--admin-text);

    font-size: 18px;

    font-weight: 650;

    letter-spacing: -0.015em;
  }

  .admin-header p {
    margin: 4px 0 0;

    overflow: hidden;

    color: var(--admin-subtle);

    font-size: 11px;

    text-overflow: ellipsis;

    white-space: nowrap;
  }

  .admin-header-actions {
    display: flex;

    flex-shrink: 0;

    align-items: center;

    gap: 8px;
  }

  /* =========================
     THEME BUTTON
  ========================= */

  .admin-theme-toggle {
    position: relative;

    display: flex;

    width: 36px;

    height: 36px;

    flex-shrink: 0;

    align-items: center;

    justify-content: center;

    padding: 8px;

    border: 1px solid var(--admin-border);

    border-radius: 50%;

    background: var(--admin-surface);

    color: var(--admin-muted);

    cursor: pointer;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .admin-theme-toggle:hover {
    background: var(--admin-hover);

    color: var(--admin-text);
  }

  .admin-theme-toggle svg {
    position: absolute;

    top: 50%;
    left: 50%;

    width: 19px;

    height: 19px;

    transform: translate(-50%, -50%);

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  /* LIGHT */

  .admin-theme-moon {
    opacity: 1;

    transform: translate(-50%, -50%) rotate(0deg) scale(1);
  }

  .admin-theme-sun {
    opacity: 0;

    transform: translate(-50%, -50%) rotate(90deg) scale(0.7);
  }

  /* DARK */

  html.dark .admin-theme-moon {
    opacity: 0;

    transform: translate(-50%, -50%) rotate(-90deg) scale(0.7);
  }

  html.dark .admin-theme-sun {
    opacity: 1;

    transform: translate(-50%, -50%) rotate(0deg) scale(1);
  }

  /* =========================
     LOGOUT
  ========================= */

  .logout-button {
    min-height: 36px;

    padding: 7px 12px;

    border: 1px solid var(--admin-border);

    border-radius: 7px;

    background: var(--admin-surface);

    color: var(--admin-muted);

    font-size: 12px;

    font-weight: 500;

    cursor: pointer;

    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .logout-button:hover {
    background: var(--admin-hover);

    color: var(--admin-text);
  }

  .logout-button:disabled {
    opacity: 0.6;

    cursor: not-allowed;
  }

  /* =========================
     CONTENT
  ========================= */

  .admin-content {
    width: 100%;

    max-width: 1100px;

    margin: 0 auto;

    padding: 32px 32px 70px;
  }

  /* =========================
     GLOBAL ADMIN CARD
  ========================= */

  .admin-card {
    padding: 24px;

    border: 1px solid var(--admin-border);

    border-radius: 10px;

    background: var(--admin-surface);

    color: var(--admin-text-soft);

    box-shadow: 0 1px 2px var(--admin-shadow);

    transition:
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  /* =========================
     GLOBAL FORM
  ========================= */

  .form-label {
    color: var(--admin-text);
  }

  .form-control {
    border-color: var(--admin-border);

    background: var(--admin-surface);

    color: var(--admin-text);
  }

  .form-control::placeholder {
    color: var(--admin-subtle);
  }

  .form-control:focus {
    border-color: var(--admin-primary);

    outline: none;

    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--admin-primary) 15%, transparent);
  }

  .form-help {
    color: var(--admin-subtle);
  }

  /* =========================
     TABLE
  ========================= */

  .admin-table {
    color: var(--admin-text-soft);
  }

  .admin-table th {
    border-color: var(--admin-border-soft);

    background: var(--admin-surface-muted);

    color: var(--admin-subtle);
  }

  .admin-table td {
    border-color: var(--admin-border-soft);

    color: var(--admin-text-soft);
  }

  /* =========================
     BUTTONS
  ========================= */

  .btn {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 6px;

    min-height: 38px;

    padding: 9px 14px;

    border: 0;

    border-radius: 7px;

    font-size: 13px;

    font-weight: 600;

    text-decoration: none;

    cursor: pointer;
  }

  .btn-primary {
    background: var(--admin-primary);

    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--admin-primary-hover);
  }

  .btn-secondary {
    border: 1px solid var(--admin-border);

    background: var(--admin-surface);

    color: var(--admin-text-soft);
  }

  .btn-secondary:hover {
    background: var(--admin-hover);

    color: var(--admin-text);
  }

  .btn-danger {
    background: var(--admin-danger-bg);

    color: var(--admin-danger);
  }

  /* =========================
     LINKS / ACTIONS
  ========================= */

  .action-link,
  .action-text-button {
    color: var(--admin-primary);
  }

  .delete-link {
    color: var(--admin-danger);
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 800px) {
    .admin-layout {
      flex-direction: column;
    }

    .admin-sidebar {
      position: static;

      width: 100%;

      padding: 15px 16px;

      border-right: 0;

      border-bottom: 1px solid var(--admin-border);
    }

    .sidebar-top {
      width: 100%;
    }

    .admin-brand {
      margin-bottom: 14px;
    }

    .admin-nav {
      width: 100%;
    }

    .sidebar-bottom {
      margin-top: 12px;
    }

    .admin-main {
      width: 100%;

      margin-left: 0;
    }

    .admin-header {
      padding: 16px 20px;
    }

    .admin-content {
      padding: 24px 20px 50px;
    }
  }

  @media (max-width: 520px) {
    .admin-header {
      align-items: flex-start;

      gap: 14px;
    }

    .admin-header-actions {
      gap: 6px;
    }

    .admin-theme-toggle {
      width: 34px;

      height: 34px;
    }

    .logout-button {
      min-height: 34px;

      padding: 6px 10px;
    }
  }
</style>
