---
import { supabase } from "@/lib/supabase";

interface Props {
  title?: string;
}

const { title = "Admin" } = Astro.props;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const theme =
          stored === "dark" || stored === "light"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body class="admin-body">
    <div class="admin-layout">
      <!-- =========================
           SIDEBAR
      ========================== -->

      <aside class="admin-sidebar">
        <div class="sidebar-top">
          <!-- BRAND -->
          <a href="/admin/modules" class="admin-brand">
            <div class="admin-brand-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>

                <path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"
                ></path>

                <path d="m10 8 4 2.5-4 2.5Z"></path>
              </svg>
            </div>

            <div class="admin-brand-content">
              <strong> Learning Modules </strong>

              <span> Admin </span>
            </div>
          </a>

          <!-- NAVIGATION -->
          <nav class="admin-nav">
            <a
              href="/admin/modules"
              class:list={[
                "admin-nav-item",
                {
                  active: isActive("/admin/modules"),
                },
              ]}
            >
              <span class="nav-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" rx="1"></rect>

                  <rect x="14" y="3" width="7" height="7" rx="1"></rect>

                  <rect x="3" y="14" width="7" height="7" rx="1"></rect>

                  <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                </svg>
              </span>

              <span> Modules </span>
            </a>
          </nav>
        </div>

        <!-- =========================
             SIDEBAR BOTTOM
        ========================== -->

        <div class="sidebar-bottom">
          <a href="/" class="back-website">
            <span class="nav-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5"></path>
                <path d="m12 19-7-7 7-7"></path>
              </svg>
            </span>

            <span> Kembali ke Website </span>
          </a>
        </div>
      </aside>

      <!-- =========================
           MAIN
      ========================== -->

      <div class="admin-main">
        <header class="admin-header">
          <div>
            <h1>
              {title}
            </h1>

            <p id="admin-user">Checking session...</p>
          </div>

          <div class="admin-header-actions">
            <button
              type="button"
              class="admin-theme-toggle"
              data-admin-theme-toggle
              aria-label="Switch to dark theme"
              aria-pressed="false"
            >
              <span class="theme-icon" aria-hidden="true"></span>
              <span data-theme-label>Dark</span>
            </button>
            <button id="logout-button" type="button" class="logout-button">
              Logout
            </button>
          </div>
        </header>

        <main class="admin-content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import { supabase } from "@/lib/supabase";

      const applyAdminTheme = (theme: "light" | "dark") => {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem("theme", theme);
        document
          .querySelectorAll<HTMLElement>("[data-admin-theme-toggle]")
          .forEach(button => {
            const isDark = theme === "dark";
            button.setAttribute(
              "aria-label",
              `Switch to ${isDark ? "light" : "dark"} theme`
            );
            button.setAttribute("aria-pressed", String(isDark));
            const label =
              button.querySelector<HTMLElement>("[data-theme-label]");
            if (label) label.textContent = isDark ? "Light" : "Dark";
          });
      };

      const setupAdminTheme = () => {
        const theme =
          document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        applyAdminTheme(theme);
        document
          .querySelectorAll<HTMLElement>("[data-admin-theme-toggle]")
          .forEach(button => {
            button.addEventListener("click", () => {
              applyAdminTheme(
                document.documentElement.dataset.theme === "dark"
                  ? "light"
                  : "dark"
              );
            });
          });
      };

      setupAdminTheme();
      document.addEventListener("astro:page-load", setupAdminTheme);

      const userElement = document.getElementById("admin-user");

      const logoutButton = document.getElementById("logout-button");

      async function checkSession() {
        const {
          data: { session },
          error,
        } = await supabase.auth.getSession();

        if (error || !session) {
          window.location.href = "/admin/login";

          return;
        }

        if (userElement) {
          userElement.textContent = session.user.email ?? "";
        }
      }

      logoutButton?.addEventListener("click", async () => {
        if (logoutButton instanceof HTMLButtonElement) {
          logoutButton.disabled = true;

          logoutButton.textContent = "Logging out...";
        }

        const { error } = await supabase.auth.signOut();

        if (error) {
          if (logoutButton instanceof HTMLButtonElement) {
            logoutButton.disabled = false;

            logoutButton.textContent = "Logout";
          }

          return;
        }

        window.location.href = "/admin/login";
      });

      checkSession();
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    --admin-bg: #f7f8fa;
    --admin-surface: #fff;
    --admin-surface-muted: #fafafa;
    --admin-hover: #f3f4f6;
    --admin-text: #111827;
    --admin-text-soft: #374151;
    --admin-muted: #6b7280;
    --admin-subtle: #9ca3af;
    --admin-border: #e5e7eb;
    --admin-border-soft: #f0f1f3;
    --admin-primary: #2563eb;
    --admin-primary-hover: #1d4ed8;
    --admin-danger: #b91c1c;
    color-scheme: light;
    background: var(--admin-bg);
  }

  html[data-theme="dark"] {
    --admin-bg: #111827;
    --admin-surface: #1f2937;
    --admin-surface-muted: #253244;
    --admin-hover: #2d3a4d;
    --admin-text: #f3f4f6;
    --admin-text-soft: #d1d5db;
    --admin-muted: #b8c1ce;
    --admin-subtle: #9ca3af;
    --admin-border: #374151;
    --admin-border-soft: #2d3748;
    --admin-primary: #60a5fa;
    --admin-primary-hover: #93c5fd;
    --admin-danger: #fca5a5;
    color-scheme: dark;
  }

  body.admin-body {
    margin: 0;

    background: #f7f8fa;

    color: #1f2937;

    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  /* =========================
     LAYOUT
  ========================= */

  .admin-layout {
    display: flex;

    min-height: 100vh;
  }

  /* =========================
     SIDEBAR
  ========================= */

  .admin-sidebar {
    position: fixed;

    top: 0;
    bottom: 0;
    left: 0;

    z-index: 40;

    display: flex;

    width: 230px;

    flex-direction: column;
    justify-content: space-between;

    padding: 22px 16px 18px;

    border-right: 1px solid #e5e7eb;

    background: #fff;
  }

  .sidebar-top {
    min-width: 0;
  }

  /* =========================
     BRAND
  ========================= */

  .admin-brand {
    display: flex;

    align-items: center;

    gap: 11px;

    margin-bottom: 32px;

    padding: 3px 5px;

    color: inherit;

    text-decoration: none;
  }

  .admin-brand-icon {
    display: flex;

    width: 38px;
    height: 38px;

    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    border: 1px solid #e5e7eb;

    border-radius: 9px;

    background: #fafafa;

    color: #374151;
  }

  .admin-brand-icon svg {
    width: 19px;
    height: 19px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .admin-brand-content {
    min-width: 0;
  }

  .admin-brand-content strong {
    display: block;

    overflow: hidden;

    color: #111827;

    font-size: 14px;
    font-weight: 650;

    line-height: 1.4;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .admin-brand-content span {
    display: block;

    margin-top: 1px;

    color: #9ca3af;

    font-size: 10px;
    font-weight: 600;

    letter-spacing: 0.07em;

    text-transform: uppercase;
  }

  /* =========================
     NAV
  ========================= */

  .admin-nav {
    display: flex;

    flex-direction: column;

    gap: 5px;
  }

  .admin-nav-item {
    display: flex;

    align-items: center;

    gap: 10px;

    min-height: 42px;

    padding: 9px 11px;

    border-radius: 7px;

    color: #6b7280;

    font-size: 13px;
    font-weight: 500;

    text-decoration: none;

    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .admin-nav-item:hover {
    background: #f5f6f8;

    color: #111827;
  }

  .admin-nav-item.active {
    background: #f3f4f6;

    color: #111827;

    font-weight: 600;
  }

  .nav-icon {
    display: flex;

    width: 20px;
    height: 20px;

    flex-shrink: 0;

    align-items: center;
    justify-content: center;
  }

  .nav-icon svg {
    width: 18px;
    height: 18px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* =========================
     SIDEBAR BOTTOM
  ========================= */

  .sidebar-bottom {
    padding-top: 16px;

    border-top: 1px solid #f0f1f3;
  }

  .back-website {
    display: flex;

    align-items: center;

    gap: 10px;

    min-height: 42px;

    padding: 9px 11px;

    border-radius: 7px;

    color: #6b7280;

    font-size: 12px;
    font-weight: 500;

    text-decoration: none;

    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .back-website:hover {
    background: #f5f6f8;

    color: #111827;
  }

  /* =========================
     MAIN
  ========================= */

  .admin-main {
    width: calc(100% - 230px);

    min-width: 0;

    margin-left: 230px;
  }

  /* =========================
     HEADER
  ========================= */

  .admin-header {
    display: flex;

    min-height: 76px;

    align-items: center;
    justify-content: space-between;

    gap: 24px;

    padding: 17px 32px;

    border-bottom: 1px solid #e5e7eb;

    background: #fff;
  }

  .admin-header h1 {
    margin: 0;

    color: #111827;

    font-size: 18px;
    font-weight: 650;

    letter-spacing: -0.015em;
  }

  .admin-header p {
    margin: 4px 0 0;

    color: #9ca3af;

    font-size: 11px;
  }

  .logout-button {
    min-height: 34px;

    padding: 7px 11px;

    border: 1px solid #e5e7eb;

    border-radius: 6px;

    background: #fff;

    color: #6b7280;

    font-size: 12px;
    font-weight: 500;

    cursor: pointer;
  }

  .logout-button:hover {
    border-color: #d1d5db;

    background: #fafafa;

    color: #111827;
  }

  .logout-button:disabled {
    opacity: 0.6;

    cursor: not-allowed;
  }

  /* =========================
     CONTENT
  ========================= */

  .admin-content {
    width: 100%;

    max-width: 1100px;

    margin: 0 auto;

    padding: 32px 32px 70px;
  }

  /* =========================
     GLOBAL ADMIN CARD
  ========================= */

  .admin-card {
    padding: 24px;

    border: 1px solid #e5e7eb;

    border-radius: 10px;

    background: #fff;
  }

  /* =========================
     BUTTONS
  ========================= */

  .btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 6px;

    min-height: 38px;

    padding: 9px 14px;

    border: 0;
    border-radius: 7px;

    font-size: 13px;
    font-weight: 600;

    text-decoration: none;

    cursor: pointer;
  }

  .btn-primary {
    background: #2563eb;

    color: #fff;
  }

  .btn-primary:hover {
    background: #1d4ed8;
  }

  .btn-secondary {
    border: 1px solid #e5e7eb;

    background: #fff;

    color: #374151;
  }

  .btn-secondary:hover {
    background: #f9fafb;
  }

  .btn-danger {
    background: #fee2e2;

    color: #b91c1c;
  }

  /* =========================
     MOBILE
  ========================= */

  .admin-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .admin-theme-toggle {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border: 1px solid var(--admin-border);
    border-radius: 6px;
    background: var(--admin-surface);
    color: var(--admin-muted);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
  }

  .admin-theme-toggle:hover {
    background: var(--admin-hover);
    color: var(--admin-text);
  }

  .theme-icon {
    width: 12px;
    height: 12px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: currentColor;
    box-shadow: inset -4px -3px 0 var(--admin-surface);
  }

  [data-theme="dark"] .theme-icon {
    background: transparent;
    box-shadow: none;
  }

  [data-theme="dark"] body.admin-body,
  [data-theme="dark"] .admin-layout {
    background: var(--admin-bg);
    color: var(--admin-text-soft);
  }

  [data-theme="dark"] .admin-sidebar,
  [data-theme="dark"] .admin-header,
  [data-theme="dark"] .admin-card,
  [data-theme="dark"] .logout-button,
  [data-theme="dark"] .btn-secondary {
    border-color: var(--admin-border);
    background: var(--admin-surface);
    color: var(--admin-text-soft);
  }

  [data-theme="dark"] .admin-brand-icon,
  [data-theme="dark"] .admin-nav-item:hover,
  [data-theme="dark"] .admin-nav-item.active,
  [data-theme="dark"] .back-website:hover,
  [data-theme="dark"] .logout-button:hover,
  [data-theme="dark"] .btn-secondary:hover {
    border-color: var(--admin-border);
    background: var(--admin-hover);
    color: var(--admin-text);
  }

  [data-theme="dark"] .admin-brand-content strong,
  [data-theme="dark"] .admin-header h1 {
    color: var(--admin-text);
  }

  [data-theme="dark"] .admin-nav-item,
  [data-theme="dark"] .back-website,
  [data-theme="dark"] .admin-header p {
    color: var(--admin-muted);
  }

  @media (max-width: 800px) {
    .admin-sidebar {
      position: static;

      width: 100%;

      padding: 15px 16px;

      border-right: 0;

      border-bottom: 1px solid #e5e7eb;
    }

    .admin-layout {
      flex-direction: column;
    }

    .sidebar-top {
      width: 100%;
    }

    .admin-brand {
      margin-bottom: 14px;
    }

    .admin-nav {
      width: 100%;
    }

    .sidebar-bottom {
      margin-top: 12px;
    }

    .admin-main {
      width: 100%;

      margin-left: 0;
    }

    .admin-header {
      padding: 16px 20px;
    }

    .admin-content {
      padding: 24px 20px 50px;
    }
  }
</style>
