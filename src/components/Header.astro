---
import { getRelativeLocaleUrl } from "astro:i18n";

import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";

import LinkButton from "./LinkButton.astro";

import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);

const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());

  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a id="skip-to-content" href="#main-content" class="skip-link">
  {t.a11y.skipToContent}
</a>

<header class="site-header">
  <div class="header-container">
    <!-- BRAND -->
    <a href={getRelativeLocaleUrl(locale, "")} class="site-brand">
      <span class="brand-title">
        {site.title}
      </span>

      <span class="brand-subtitle"> Learning Center </span>
    </a>

    <!-- MOBILE BUTTON -->
    <button
      id="menu-btn"
      class="menu-button"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="menu-items"
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
    >
      <IconX id="close-icon" class="hidden" />

      <IconMenuDeep id="menu-icon" />
    </button>

    <!-- NAV -->
    <nav id="nav-menu" class="navigation">
      <ul id="menu-items" class="nav-items">
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "")}
            class:list={{
              active: currentPath === "/",
            }}
          >
            Home
          </a>
        </li>

        <!-- <li>
          <a
            href={getRelativeLocaleUrl(
              locale,
              "modules"
            )}
            class:list={{
              active:
                isActive("/modules"),
            }}
          >
            Materi
          </a>
        </li> -->

        <!-- {
          features.search !== false && (
            <li class="icon-item">
              <LinkButton
                href={getRelativeLocaleUrl(
                  locale,
                  "search"
                )}
                class="icon-button"
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <IconSearch />

                <span class="sr-only">
                  {t.nav.search}
                </span>
              </LinkButton>
            </li>
          )
        } -->

        {
          features.lightAndDarkMode && (
            <li class="icon-item">
              <button
                id="theme-btn"
                class="icon-button theme-button"
                title={t.a11y.toggleTheme}
                aria-label={t.a11y.toggleTheme}
                aria-pressed="false"
                data-light-label="Use light theme"
                data-dark-label="Use dark theme"
              >
                <IconMoon class="theme-moon" />

                <IconSunHigh class="theme-sun" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");

    const menuItems = document.querySelector("#menu-items");

    const menuIcon = document.querySelector("#menu-icon");

    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) {
      return;
    }

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";

    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");

      menuBtn.setAttribute("aria-label", isOpen ? openLabel : closeLabel);

      menuItems.classList.toggle("open");

      menuIcon.classList.toggle("hidden");

      closeIcon.classList.toggle("hidden");
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");

    if (!skipLink) return;

    skipLink.addEventListener("click", event => {
      if (
        event.defaultPrevented ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.button !== 0
      ) {
        return;
      }

      event.preventDefault();

      const target = document.getElementById("main-content");

      if (!target) return;

      target.setAttribute("tabindex", "-1");

      target.addEventListener(
        "blur",
        () => target.removeAttribute("tabindex"),
        {
          once: true,
        }
      );

      target.focus();

      target.scrollIntoView({
        behavior: "smooth",
      });
    });
  }

  toggleNav();

  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();

  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>

<style>
  .site-header {
    position: relative;
    z-index: 30;

    width: 100%;

    background: var(--surface);

    border-bottom: 1px solid var(--border);
  }

  .header-container {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: space-between;

    width: min(100% - 40px, 920px);

    min-height: 74px;

    margin: 0 auto;
  }

  /* =========================
     BRAND
  ========================= */

  .site-brand {
    display: flex;
    flex-direction: column;

    gap: 2px;

    color: var(--foreground-strong);

    text-decoration: none;
  }

  .brand-title {
    font-size: 18px;
    font-weight: 700;

    line-height: 1.2;

    letter-spacing: -0.02em;
  }

  .brand-subtitle {
    color: var(--foreground-subtle);

    font-size: 11px;
    font-weight: 500;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  /* =========================
     NAVIGATION
  ========================= */

  .navigation {
    display: flex;
    align-items: center;
  }

  .nav-items {
    display: flex;
    align-items: center;

    gap: 6px;

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .nav-items > li > a {
    position: relative;

    display: flex;
    align-items: center;

    min-height: 36px;

    padding: 6px 10px;

    color: var(--foreground-muted);

    font-size: 14px;
    font-weight: 500;

    text-decoration: none;

    transition: color 0.15s ease;
  }

  .nav-items > li > a:hover {
    color: var(--foreground-strong);
  }

  .nav-items > li > a.active {
    color: var(--foreground-strong);

    font-weight: 600;
  }

  .nav-items > li > a.active::after {
    position: absolute;

    right: 10px;
    bottom: 0;
    left: 10px;

    height: 1px;

    background: var(--foreground-strong);

    content: "";
  }

  /* =========================
     ICON BUTTON
  ========================= */

  .icon-item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-button {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 36px;
    height: 36px;

    padding: 8px;

    border: 0;
    border-radius: 50%;

    background: transparent;

    color: var(--foreground-muted);

    cursor: pointer;

    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .icon-button:hover {
    background: var(--surface-muted);
    color: var(--foreground-strong);
  }

  .icon-button :global(svg) {
    width: 20px;
    height: 20px;
  }

  /* =========================
     THEME
  ========================= */

  .theme-button {
    position: relative;
  }

  .theme-moon,
  .theme-sun {
    position: absolute;

    top: 50%;
    left: 50%;

    width: 20px;
    height: 20px;

    transform: translate(-50%, -50%);

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .theme-moon {
    opacity: 1;
  }

  .theme-sun {
    opacity: 0;

    transform: translate(-50%, -50%) rotate(90deg) scale(0.7);
  }

  :global(.dark) .theme-moon {
    opacity: 0;

    transform: translate(-50%, -50%) rotate(-90deg) scale(0.7);
  }

  :global(.dark) .theme-sun {
    opacity: 1;

    transform: translate(-50%, -50%) rotate(0) scale(1);
  }

  /* =========================
     MOBILE MENU
  ========================= */

  .menu-button {
    display: none;

    width: 38px;
    height: 38px;

    align-items: center;
    justify-content: center;

    padding: 8px;

    border: 0;

    background: transparent;

    color: var(--foreground-strong);

    cursor: pointer;
  }

  .menu-button :global(svg) {
    width: 22px;
    height: 22px;
  }

  .hidden {
    display: none !important;
  }

  /* =========================
     ACCESSIBILITY
  ========================= */

  .skip-link {
    position: absolute;

    top: -100px;
    left: 16px;

    z-index: 100;

    padding: 8px 12px;

    background: var(--foreground-strong);
    color: var(--surface);

    font-size: 13px;

    text-decoration: none;
  }

  .skip-link:focus {
    top: 12px;
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 640px) {
    .header-container {
      width: min(100% - 30px, 920px);

      min-height: 66px;

      flex-wrap: wrap;
    }

    .brand-title {
      font-size: 17px;
    }

    .menu-button {
      display: flex;
    }

    .navigation {
      width: 100%;
    }

    .nav-items {
      display: none;

      width: 100%;

      flex-direction: column;

      align-items: stretch;

      gap: 2px;

      padding: 10px 0 16px;
    }

    .nav-items.open {
      display: flex;
    }

    .nav-items > li {
      width: 100%;
    }

    .nav-items > li > a {
      min-height: 42px;

      padding: 10px 0;

      border-bottom: 1px solid var(--border);
    }

    .nav-items > li > a.active::after {
      display: none;
    }

    .icon-item {
      justify-content: flex-start;
    }

    .icon-button {
      width: 42px;
      height: 42px;

      border-radius: 0;
    }
  }
</style>
