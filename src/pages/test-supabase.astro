---
import { supabase } from "../lib/supabase";

const { data, error } = await supabase
  .from("modules")
  .select("*");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Supabase Test</title>
  </head>

  <body>
    <h1>Supabase Test</h1>

    {
      error ? (
        <pre>{JSON.stringify(error, null, 2)}</pre>
      ) : (
        <pre>{JSON.stringify(data, null, 2)}</pre>
      )
    }
  </body>
</html>