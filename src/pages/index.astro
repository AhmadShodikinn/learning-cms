---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { supabase } from "@/lib/supabase";

const { data: modules, error } = await supabase
  .from("modules")
  .select("*")
  .eq("is_published", true)
  .order("category", {
    ascending: true,
    nullsFirst: false,
  })
  .order("group_name", {
    ascending: true,
    nullsFirst: false,
  })
  .order("sort_order", {
    ascending: true,
  })
  .order("created_at", {
    ascending: false,
  });

function getYoutubeThumbnail(url: string | null) {
  if (!url) return null;

  try {
    const parsed = new URL(url);

    let videoId = "";

    if (parsed.hostname.includes("youtu.be")) {
      videoId = parsed.pathname.replace("/", "");
    }

    if (parsed.hostname.includes("youtube.com")) {
      videoId =
        parsed.searchParams.get("v") ?? "";

      if (
        !videoId &&
        parsed.pathname.includes("/shorts/")
      ) {
        videoId =
          parsed.pathname
            .split("/shorts/")[1]
            ?.split("/")[0] ?? "";
      }

      if (
        !videoId &&
        parsed.pathname.includes("/embed/")
      ) {
        videoId =
          parsed.pathname
            .split("/embed/")[1]
            ?.split("/")[0] ?? "";
      }
    }

    if (!videoId) {
      return null;
    }

    return `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
  } catch {
    return null;
  }
}

/* =========================
   CATEGORY FILTER
========================= */

const categories = [
  ...new Set(
    (modules ?? [])
      .map(module => module.category)
      .filter(
        (category): category is string =>
          Boolean(category)
      )
  ),
];

/* =========================
   GROUP MODULES
========================= */

type ModuleRecord =
  NonNullable<typeof modules>[number];

type GroupedModules = Record<
  string,
  Record<string, ModuleRecord[]>
>;

const groupedModules =
  (modules ?? []).reduce<GroupedModules>(
    (result, module) => {
      const category =
        module.category?.trim() ||
        "Lainnya";

      const groupName =
        module.group_name?.trim() ||
        "Materi Lainnya";

      if (!result[category]) {
        result[category] = {};
      }

      if (!result[category][groupName]) {
        result[category][groupName] = [];
      }

      result[category][groupName].push(
        module
      );

      return result;
    },
    {}
  );
---

<Layout>
  <Header />

  <main class="learning-page">

    <div class="learning-container">

      <!-- TOOLBAR -->
      <section class="toolbar">

        <div class="search-wrapper">

          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"
            ></path>
          </svg>

          <input
            id="module-search"
            type="search"
            placeholder="Cari materi pembelajaran..."
            autocomplete="off"
          />

        </div>


        <div class="select-wrapper">

          <select id="category-filter">

            <option value="">
              Semua Pelajaran
            </option>

            {
              categories.map(category => (
                <option value={category}>
                  {category}
                </option>
              ))
            }

          </select>

          <svg
            class="select-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="m7 10 5 5 5-5"></path>
          </svg>

        </div>

      </section>


      <!-- MODULE LIST -->
      <section class="module-list">

        {
          error ? (

            <div class="empty-state">
              Gagal memuat materi pembelajaran.
            </div>

          ) : modules &&
            modules.length > 0 ? (

            <>

              {
                Object.entries(
                  groupedModules
                ).map(
                  ([category, groups]) => (

                    <section
                      class="category-section"
                      data-category-section
                      data-category-name={
                        category.toLowerCase()
                      }
                    >

                      <!-- CATEGORY HEADER -->
                      <header class="category-heading">

                        <span class="category-label">
                          Mata Pelajaran
                        </span>

                        <div class="category-title-row">

                          <h2>
                            {category}
                          </h2>

                          <span class="category-count">
                            {
                              Object.values(
                                groups
                              ).reduce(
                                (
                                  total,
                                  groupModules
                                ) =>
                                  total +
                                  groupModules.length,
                                0
                              )
                            }{" "}
                            Materi
                          </span>

                        </div>

                      </header>


                      <!-- GROUPS -->
                      <div class="category-groups">

                        {
                          Object.entries(
                            groups
                          ).map(
                            ([
                              groupName,
                              groupModules,
                            ]) => (

                              <section
                                class="group-section"
                                data-group-section
                              >

                                <!-- MODULES -->
                                <div class="group-modules">

                                  {
                                    groupModules.map(
                                      module => {

                                        const thumbnail =
                                          getYoutubeThumbnail(
                                            module.youtube_url
                                          );

                                        return (

                                          <article
                                            class="module-item"
                                            data-module-card
                                            data-title={
                                              module.title
                                                ?.toLowerCase() ??
                                              ""
                                            }
                                            data-category={
                                              module.category
                                                ?.toLowerCase() ??
                                              ""
                                            }
                                            data-group={
                                              module.group_name
                                                ?.toLowerCase() ??
                                              ""
                                            }
                                            data-description={
                                              module.description
                                                ?.toLowerCase() ??
                                              ""
                                            }
                                          >

                                            <!-- IMAGE -->
                                            <a
                                              class="module-image"
                                              href={`/modules/${module.slug}`}
                                              aria-label={
                                                module.title
                                              }
                                            >

                                              {
                                                thumbnail ? (

                                                  <img
                                                    src={
                                                      thumbnail
                                                    }
                                                    alt={
                                                      module.title
                                                    }
                                                    loading="lazy"
                                                  />

                                                ) : (

                                                  <div class="no-thumbnail">
                                                    No Video
                                                  </div>

                                                )
                                              }

                                              <span class="play-button">
                                                ▶
                                              </span>

                                            </a>


                                            <!-- INFO -->
                                            <div class="module-info">

                                              <div class="module-top-meta">

                                                <span class="module-category">
                                                  {
                                                    module.category ??
                                                    category
                                                  }
                                                </span>

                                                {
                                                  module.group_name && (
                                                    <>
                                                      <span class="module-dot">
                                                        •
                                                      </span>

                                                      <span class="module-group">
                                                        {
                                                          module.group_name
                                                        }
                                                      </span>
                                                    </>
                                                  )
                                                }

                                              </div>


                                              <h2>

                                                <a
                                                  href={`/modules/${module.slug}`}
                                                >
                                                  {
                                                    module.title
                                                  }
                                                </a>

                                              </h2>


                                              {
                                                module.description && (

                                                  <p class="module-description">

                                                    {
                                                      module
                                                        .description
                                                        .length >
                                                      180
                                                        ? module.description.slice(
                                                            0,
                                                            180
                                                          ) +
                                                          "..."
                                                        : module.description
                                                    }

                                                  </p>

                                                )
                                              }


                                              <div class="module-meta">

                                                <span>
                                                  Module{" "}
                                                  {
                                                    String(
                                                      module.sort_order ??
                                                        0
                                                    ).padStart(
                                                      2,
                                                      "0"
                                                    )
                                                  }
                                                </span>

                                                <span class="separator">
                                                  •
                                                </span>

                                                <a
                                                  class="detail-link"
                                                  href={`/modules/${module.slug}`}
                                                >
                                                  Tonton Materi

                                                  <span>
                                                    →
                                                  </span>
                                                </a>

                                              </div>

                                            </div>

                                          </article>

                                        );
                                      }
                                    )
                                  }

                                </div>

                              </section>

                            )
                          )
                        }

                      </div>

                    </section>

                  )
                )
              }


              <div
                id="empty-filter-result"
                class="empty-state"
                hidden
              >
                Materi tidak ditemukan.
              </div>

            </>

          ) : (

            <div class="empty-state">
              Belum ada materi pembelajaran.
            </div>

          )
        }

      </section>

    </div>

  </main>

  <Footer />

</Layout>


<script>
  const searchInput =
    document.querySelector<HTMLInputElement>(
      "#module-search"
    );

  const categoryFilter =
    document.querySelector<HTMLSelectElement>(
      "#category-filter"
    );

  const cards =
    document.querySelectorAll<HTMLElement>(
      "[data-module-card]"
    );

  const groups =
    document.querySelectorAll<HTMLElement>(
      "[data-group-section]"
    );

  const categorySections =
    document.querySelectorAll<HTMLElement>(
      "[data-category-section]"
    );

  const emptyResult =
    document.querySelector<HTMLElement>(
      "#empty-filter-result"
    );


  function filterModules() {

    const keyword =
      searchInput?.value
        .trim()
        .toLowerCase() ?? "";

    const selectedCategory =
      categoryFilter?.value
        .trim()
        .toLowerCase() ?? "";

    let visibleCount = 0;


    /* FILTER MODULE CARD */

    cards.forEach(card => {

      const title =
        card.dataset.title ?? "";

      const category =
        card.dataset.category ?? "";

      const group =
        card.dataset.group ?? "";

      const description =
        card.dataset.description ?? "";


      const matchesSearch =
        !keyword ||
        title.includes(keyword) ||
        category.includes(keyword) ||
        group.includes(keyword) ||
        description.includes(keyword);


      const matchesCategory =
        !selectedCategory ||
        category === selectedCategory;


      const visible =
        matchesSearch &&
        matchesCategory;


      card.hidden =
        !visible;


      if (visible) {
        visibleCount++;
      }

    });


    /* HIDE EMPTY GROUP */

    groups.forEach(group => {

      const groupCards =
        group.querySelectorAll<HTMLElement>(
          "[data-module-card]"
        );

      const hasVisibleCard =
        Array.from(
          groupCards
        ).some(
          card =>
            !card.hidden
        );

      group.hidden =
        !hasVisibleCard;

    });


    /* HIDE EMPTY CATEGORY */

    categorySections.forEach(
      categorySection => {

        const categoryGroups =
          categorySection.querySelectorAll<HTMLElement>(
            "[data-group-section]"
          );

        const hasVisibleGroup =
          Array.from(
            categoryGroups
          ).some(
            group =>
              !group.hidden
          );

        categorySection.hidden =
          !hasVisibleGroup;

      }
    );


    /* EMPTY RESULT */

    if (emptyResult) {

      emptyResult.hidden =
        visibleCount > 0;

    }

  }


  searchInput?.addEventListener(
    "input",
    filterModules
  );


  categoryFilter?.addEventListener(
    "change",
    filterModules
  );
</script>


<style>
  /* =========================
     PAGE
  ========================= */

  .learning-page {
    min-height: 100vh;

    background: var(--surface);

    color: var(--foreground);
  }


  .learning-container {
    width: min(
      100% - 40px,
      920px
    );

    margin: 0 auto;

    padding:
      70px 0
      90px;
  }


  /* =========================
     TOOLBAR
  ========================= */

  .toolbar {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      190px;

    gap: 12px;

    margin-bottom: 54px;
  }


  /* SEARCH */

  .search-wrapper {
    display: flex;

    height: 46px;

    align-items: center;

    padding:
      0 15px;

    border:
      1px solid
      var(--border);

    border-radius: 7px;

    background:
      var(--surface);

    transition:
      border-color
        0.15s ease,
      box-shadow
        0.15s ease;
  }


  .search-wrapper:focus-within {
    border-color:
      var(--foreground-subtle);

    box-shadow:
      0 0 0 3px
      var(--focus-shadow);
  }


  .search-wrapper svg {
    width: 17px;
    height: 17px;

    flex-shrink: 0;

    margin-right: 11px;

    fill: none;

    stroke:
      var(--foreground-muted);

    stroke-width: 1.8;
    stroke-linecap: round;
  }


  .search-wrapper input {
    width: 100%;

    border: 0;

    outline: 0;

    background:
      transparent;

    color:
      var(--foreground-strong);

    font: inherit;
    font-size: 14px;
  }


  .search-wrapper input::placeholder {
    color:
      var(--foreground-subtle);
  }


  /* SELECT */

  .select-wrapper {
    position: relative;

    min-width: 190px;
  }


  .select-wrapper select {
    width: 100%;
    height: 46px;

    padding:
      0 42px
      0 14px;

    border:
      1px solid
      var(--border);

    border-radius: 7px;

    outline: none;

    background:
      var(--surface);

    color:
      var(--foreground);

    font: inherit;
    font-size: 13px;

    cursor: pointer;

    appearance: none;

    -webkit-appearance:
      none;

    -moz-appearance:
      none;

    transition:
      border-color
        0.15s ease,
      box-shadow
        0.15s ease;
  }


  .select-wrapper select:hover {
    border-color:
      var(--border-strong);
  }


  .select-wrapper select:focus {
    border-color:
      var(--border-strong);

    box-shadow:
      0 0 0 3px
      var(--focus-shadow);
  }


  .select-icon {
    position: absolute;

    top: 50%;
    right: 13px;

    width: 17px;
    height: 17px;

    transform:
      translateY(-50%);

    fill: none;

    stroke:
      var(--foreground-muted);

    stroke-width: 1.8;

    stroke-linecap:
      round;

    stroke-linejoin:
      round;

    pointer-events:
      none;
  }


  /* =========================
     CATEGORY
  ========================= */

  .category-section {
    margin-bottom: 72px;
  }


  .category-section[hidden] {
    display: none;
  }


  .category-heading {
    margin-bottom: 32px;
  }


  .category-label {
    display: block;

    margin-bottom: 8px;

    color:
      var(--foreground-subtle);

    font-size: 11px;
    font-weight: 600;

    letter-spacing:
      0.09em;

    text-transform:
      uppercase;
  }


  .category-title-row {
    display: flex;

    align-items: flex-end;

    justify-content:
      space-between;

    gap: 20px;

    padding-bottom: 18px;

    border-bottom:
      1px solid
      var(--border);
  }


  .category-title-row h2 {
    margin: 0;

    color:
      var(--foreground-strong);

    font-size:
      clamp(
        28px,
        4vw,
        34px
      );

    font-weight: 700;

    line-height: 1.2;

    letter-spacing:
      -0.035em;
  }


  .category-count {
    flex-shrink: 0;

    padding-bottom: 3px;

    color:
      var(--foreground-subtle);

    font-size: 12px;
  }


  /* =========================
     GROUP
  ========================= */

  .category-groups {
    display: flex;

    flex-direction:
      column;

    gap: 48px;
  }


  .group-section[hidden] {
    display: none;
  }


  .group-heading {
    display: flex;

    align-items: flex-end;

    justify-content:
      space-between;

    gap: 24px;

    margin-bottom: 0;

    padding-bottom: 14px;

    border-bottom:
      1px solid
      var(--border);
  }


  .group-label {
    display: block;

    margin-bottom: 5px;

    color:
      var(--foreground-subtle);

    font-size: 10px;
    font-weight: 600;

    letter-spacing:
      0.09em;

    text-transform:
      uppercase;
  }


  .group-heading h3 {
    margin: 0;

    color:
      var(--foreground-strong);

    font-size: 19px;

    font-weight: 650;

    line-height: 1.35;

    letter-spacing:
      -0.015em;
  }


  .group-count {
    flex-shrink: 0;

    padding-bottom: 2px;

    color:
      var(--foreground-subtle);

    font-size: 12px;
  }


  /* =========================
     MODULE LIST
  ========================= */

  .group-modules {
    width: 100%;
  }


  .module-item {
    display: grid;

    grid-template-columns:
      230px
      minmax(0, 1fr);

    gap: 30px;

    padding:
      30px 0;

    border-bottom:
      1px solid
      var(--border);
  }


  .module-item[hidden] {
    display: none;
  }


  .group-modules
  .module-item:last-child {
    border-bottom: 0;
  }


  /* =========================
     IMAGE
  ========================= */

  .module-image {
    position: relative;

    display: block;

    align-self: start;

    aspect-ratio:
      16 / 10;

    overflow: hidden;

    border-radius: 7px;

    background:
      var(--surface-muted);
  }


  .module-image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform
        0.3s ease;
  }


  .module-item:hover
  .module-image img {
    transform:
      scale(1.03);
  }


  .no-thumbnail {
    display: flex;

    width: 100%;
    height: 100%;

    align-items: center;

    justify-content:
      center;

    color:
      var(--foreground-subtle);

    font-size: 13px;
  }


  .play-button {
    position: absolute;

    right: 12px;
    bottom: 12px;

    display: flex;

    width: 38px;
    height: 38px;

    align-items: center;

    justify-content:
      center;

    padding-left: 2px;

    border-radius: 50%;

    background:
      var(--overlay);

    color:
      var(--foreground-strong);

    font-size: 13px;

    box-shadow:
      0 3px 12px
      var(--shadow);
  }


  /* =========================
     MODULE CONTENT
  ========================= */

  .module-info {
    display: flex;

    min-width: 0;

    flex-direction:
      column;

    justify-content:
      center;
  }


  .module-top-meta {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 7px;

    margin-bottom: 9px;

    color:
      var(--foreground-muted);

    font-size: 11px;

    font-weight: 600;

    letter-spacing:
      0.07em;

    text-transform:
      uppercase;
  }


  .module-category {
    color:
      var(--foreground-muted);
  }


  .module-group {
    color:
      var(--foreground-subtle);
  }


  .module-dot {
    color:
      var(--border-strong);
  }


  .module-info h2 {
    margin: 0;

    color:
      var(--foreground-strong);

    font-size: 23px;

    font-weight: 650;

    line-height: 1.35;

    letter-spacing:
      -0.02em;
  }


  .module-info h2 a {
    color: inherit;

    text-decoration:
      none;
  }


  .module-info h2 a:hover {
    text-decoration:
      underline;

    text-decoration-thickness:
      1px;

    text-underline-offset:
      4px;
  }


  .module-description {
    display:
      -webkit-box;

    margin:
      12px 0
      0;

    overflow: hidden;

    color:
      var(--foreground-muted);

    font-size: 14px;

    line-height: 1.7;

    -webkit-box-orient:
      vertical;

    -webkit-line-clamp:
      3;
  }


  /* =========================
     META
  ========================= */

  .module-meta {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 8px;

    margin-top: 18px;

    color:
      var(--foreground-subtle);

    font-size: 13px;
  }


  .separator {
    color:
      var(--border-strong);
  }


  .detail-link {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    color:
      var(--foreground);

    font-weight: 600;

    text-decoration:
      none;
  }


  .detail-link span {
    transition:
      transform
        0.15s ease;
  }


  .detail-link:hover span {
    transform:
      translateX(3px);
  }


  /* =========================
     EMPTY
  ========================= */

  .empty-state {
    padding:
      70px 20px;

    border-top:
      1px solid
      var(--border);

    border-bottom:
      1px solid
      var(--border);

    color:
      var(--foreground-muted);

    text-align:
      center;

    font-size: 14px;
  }


  .empty-state[hidden] {
    display: none;
  }


  /* =========================
     TABLET
  ========================= */

  @media (
    max-width: 760px
  ) {

    .learning-container {
      padding-top:
        45px;
    }


    .toolbar {
      grid-template-columns:
        1fr;

      margin-bottom:
        44px;
    }


    .category-section {
      margin-bottom:
        58px;
    }


    .category-groups {
      gap: 40px;
    }


    .module-item {
      grid-template-columns:
        190px
        minmax(0, 1fr);

      gap: 22px;
    }


    .module-info h2 {
      font-size: 20px;
    }

  }


  /* =========================
     MOBILE
  ========================= */

  @media (
    max-width: 560px
  ) {

    .learning-container {
      width: min(
        100% - 30px,
        920px
      );

      padding:
        40px 0
        60px;
    }


    .toolbar {
      margin-bottom:
        40px;
    }


    .category-section {
      margin-bottom:
        52px;
    }


    .category-title-row {
      align-items:
        flex-start;

      flex-direction:
        column;

      gap: 8px;
    }


    .category-title-row h2 {
      font-size: 27px;
    }


    .category-count {
      padding-bottom: 0;
    }


    .category-groups {
      gap: 36px;
    }


    .group-heading {
      align-items:
        flex-start;

      flex-direction:
        column;

      gap: 7px;
    }


    .group-heading h3 {
      font-size: 18px;
    }


    .group-count {
      padding-bottom: 0;
    }


    .module-item {
      grid-template-columns:
        1fr;

      gap: 19px;

      padding:
        25px 0;
    }


    .module-image {
      aspect-ratio:
        16 / 9;
    }


    .module-info {
      display: block;
    }


    .module-info h2 {
      font-size: 21px;
    }


    .module-description {
      margin-top: 10px;
    }

  }
</style>