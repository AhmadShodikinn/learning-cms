---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Admin Dashboard">
  <section class="page-heading">
    <div>
      <span class="eyebrow"> Dashboard </span>

      <h1>Admin Dashboard</h1>

      <p>Kelola konten pembelajaran dan lihat website publik.</p>
    </div>
  </section>

  <section class="admin-grid">
    <a href="/admin/modules" class="dashboard-card">
      <div class="admin-card-icon">M</div>

      <div class="admin-card-content">
        <h2>Learning Modules</h2>

        <p>Kelola materi pembelajaran, video, kategori, dan urutan modul.</p>

        <span> Kelola Materi → </span>
      </div>
    </a>

    <a href="/" class="dashboard-card">
      <div class="admin-card-icon">V</div>

      <div class="admin-card-content">
        <h2>View Website</h2>

        <p>Lihat tampilan halaman pembelajaran yang dapat diakses siswa.</p>

        <span> Buka Website → </span>
      </div>
    </a>
  </section>
</AdminLayout>

<style>
  .page-heading {
    margin-bottom: 36px;
  }

  .eyebrow {
    display: block;
    margin-bottom: 10px;
    color: var(--admin-subtle);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-heading h1 {
    margin: 0;
    color: var(--admin-text);
    font-size: clamp(30px, 5vw, 42px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .page-heading p {
    margin: 12px 0 0;
    color: var(--admin-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .admin-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    padding-top: 26px;
    border-top: 1px solid var(--admin-border);
  }

  .dashboard-card {
    display: flex;
    gap: 18px;
    padding: 22px;
    border: 1px solid var(--admin-border);
    border-radius: 10px;
    background: var(--admin-surface);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 8px 24px var(--admin-shadow);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      background 0.15s ease;
  }

  .dashboard-card:hover {
    background: var(--admin-hover);
    transform: translateY(-1px);
  }

  .admin-card-icon {
    display: flex;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--admin-border);
    border-radius: 8px;
    color: var(--admin-text-soft);
    font-size: 13px;
    font-weight: 700;
  }

  .admin-card-content {
    min-width: 0;
  }

  .admin-card-content h2 {
    margin: 0 0 8px;
    color: var(--admin-text);
    font-size: 16px;
    font-weight: 650;
  }

  .admin-card-content p {
    margin: 0;
    color: var(--admin-muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .admin-card-content span {
    display: inline-block;
    margin-top: 14px;
    color: var(--admin-text-soft);
    font-size: 13px;
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .admin-grid {
      grid-template-columns: 1fr;
    }

    .dashboard-card {
      padding: 18px;
    }
  }
</style>
