---
import { supabase } from "../../lib/supabase";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login</title>
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        document.documentElement.dataset.theme =
          stored === "dark" || stored === "light"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      })();
    </script>
  </head>

  <body>
    <main class="login-page">
      <button
        type="button"
        class="theme-toggle"
        data-admin-theme-toggle
        aria-label="Toggle color theme">Theme</button
      >
      <div class="login-container">
        <div class="login-header">
          <span class="eyebrow"> Admin Access </span>

          <h1>Sign in</h1>

          <p>Masuk untuk mengelola materi pembelajaran.</p>
        </div>

        <form id="login-form" class="login-form">
          <div class="form-group">
            <label for="email"> Email </label>

            <input
              id="email"
              type="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>

          <div class="form-group">
            <label for="password"> Password </label>

            <input
              id="password"
              type="password"
              name="password"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            />
          </div>

          <button id="submit-button" type="submit" class="login-button">
            Sign in
          </button>

          <p id="message" class="form-message" aria-live="polite"></p>
        </form>

        <div class="login-footer">
          <a href="/"> ← Kembali ke halaman pembelajaran </a>
        </div>
      </div>
    </main>

    <script>
      import { supabase } from "../../lib/supabase";

      const setupTheme = () => {
        const button = document.querySelector<HTMLElement>(
          "[data-admin-theme-toggle]"
        );
        const update = (theme: "light" | "dark") => {
          document.documentElement.dataset.theme = theme;
          localStorage.setItem("theme", theme);
          if (button) {
            button.textContent = theme === "dark" ? "Light" : "Dark";
            button.setAttribute(
              "aria-label",
              `Switch to ${theme === "dark" ? "light" : "dark"} theme`
            );
          }
        };
        update(
          document.documentElement.dataset.theme === "dark" ? "dark" : "light"
        );
        button?.addEventListener("click", () =>
          update(
            document.documentElement.dataset.theme === "dark" ? "light" : "dark"
          )
        );
      };

      setupTheme();
      document.addEventListener("astro:page-load", setupTheme);

      const form = document.getElementById("login-form");

      const message = document.getElementById("message");

      const submitButton = document.getElementById("submit-button");

      form?.addEventListener("submit", async event => {
        event.preventDefault();

        const emailInput = document.getElementById("email");

        const passwordInput = document.getElementById("password");

        if (
          !(emailInput instanceof HTMLInputElement) ||
          !(passwordInput instanceof HTMLInputElement)
        ) {
          return;
        }

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.textContent = "Signing in...";
        }

        if (message) {
          message.textContent = "";
          message.className = "form-message";
        }

        const { error } = await supabase.auth.signInWithPassword({
          email: emailInput.value,
          password: passwordInput.value,
        });

        if (error) {
          if (message) {
            message.textContent = error.message;

            message.className = "form-message error";
          }

          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;

            submitButton.textContent = "Sign in";
          }

          return;
        }

        if (message) {
          message.textContent = "Login berhasil.";

          message.className = "form-message success";
        }

        window.location.href = "/admin";
      });
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  html {
    background: #fff;
  }

  body {
    margin: 0;

    background: #fff;
    color: #222;

    font-family:
      Inter,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  /* =========================
     PAGE
  ========================= */

  .login-page {
    display: flex;

    min-height: 100vh;

    align-items: center;
    justify-content: center;

    padding: 40px 20px;
  }

  .login-container {
    width: 100%;
    max-width: 420px;
  }

  /* =========================
     HEADER
  ========================= */

  .login-header {
    margin-bottom: 30px;
  }

  .eyebrow {
    display: block;

    margin-bottom: 10px;

    color: #999;

    font-size: 12px;
    font-weight: 600;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .login-header h1 {
    margin: 0;

    color: #171717;

    font-size: 34px;
    font-weight: 700;

    line-height: 1.15;

    letter-spacing: -0.035em;
  }

  .login-header p {
    margin: 12px 0 0;

    color: #777;

    font-size: 14px;

    line-height: 1.65;
  }

  /* =========================
     FORM
  ========================= */

  .login-form {
    padding-top: 26px;

    border-top: 1px solid #e7e7e7;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-group label {
    display: block;

    margin-bottom: 7px;

    color: #333;

    font-size: 13px;
    font-weight: 600;
  }

  .form-group input {
    width: 100%;
    height: 46px;

    padding: 0 13px;

    border: 1px solid #dedede;

    border-radius: 6px;

    outline: none;

    background: #fff;

    color: #222;

    font: inherit;
    font-size: 14px;

    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .form-group input::placeholder {
    color: #aaa;
  }

  .form-group input:focus {
    border-color: #999;

    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.04);
  }

  /* =========================
     BUTTON
  ========================= */

  .login-button {
    width: 100%;
    height: 46px;

    margin-top: 4px;

    border: 1px solid #1f1f1f;

    border-radius: 6px;

    background: #1f1f1f;

    color: #fff;

    font: inherit;
    font-size: 14px;
    font-weight: 600;

    cursor: pointer;

    transition:
      background 0.15s ease,
      opacity 0.15s ease;
  }

  .login-button:hover {
    background: #000;
  }

  .login-button:disabled {
    opacity: 0.6;

    cursor: not-allowed;
  }

  /* =========================
     MESSAGE
  ========================= */

  .form-message {
    min-height: 20px;

    margin: 12px 0 0;

    color: #777;

    font-size: 13px;

    line-height: 1.5;
  }

  .form-message.error {
    color: #b42318;
  }

  .form-message.success {
    color: #267a4a;
  }

  /* =========================
     FOOTER
  ========================= */

  .login-footer {
    margin-top: 26px;

    padding-top: 20px;

    border-top: 1px solid #e7e7e7;
  }

  .login-footer a {
    color: #777;

    font-size: 13px;
    font-weight: 500;

    text-decoration: none;

    transition: color 0.15s ease;
  }

  .login-footer a:hover {
    color: #171717;
  }

  /* =========================
     MOBILE
  ========================= */

  .theme-toggle {
    position: fixed;
    top: 20px;
    right: 20px;
    padding: 8px 12px;
    border: 1px solid #dedede;
    border-radius: 6px;
    background: #fff;
    color: #444;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  :global([data-theme="dark"]) {
    color-scheme: dark;
    background: #111827;
  }

  :global([data-theme="dark"]) body,
  :global([data-theme="dark"]) .login-page {
    background: #111827;
    color: #e5e7eb;
  }

  :global([data-theme="dark"]) .login-header h1,
  :global([data-theme="dark"]) .form-group label {
    color: #f3f4f6;
  }

  :global([data-theme="dark"]) .eyebrow,
  :global([data-theme="dark"]) .login-header p,
  :global([data-theme="dark"]) .login-footer a,
  :global([data-theme="dark"]) .form-message {
    color: #9ca3af;
  }

  :global([data-theme="dark"]) .login-form,
  :global([data-theme="dark"]) .login-footer {
    border-color: #374151;
  }

  :global([data-theme="dark"]) .form-group input,
  :global([data-theme="dark"]) .theme-toggle {
    border-color: #4b5563;
    background: #1f2937;
    color: #f3f4f6;
  }

  :global([data-theme="dark"]) .login-button {
    border-color: #60a5fa;
    background: #2563eb;
  }

  @media (max-width: 480px) {
    .login-page {
      align-items: flex-start;

      padding: 70px 20px 40px;
    }

    .login-header h1 {
      font-size: 30px;
    }
  }
</style>
