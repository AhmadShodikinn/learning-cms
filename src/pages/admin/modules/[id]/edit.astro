---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { supabase } from "../../../../lib/supabase";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/modules");
}

const { data: moduleData, error } = await supabase
  .from("modules")
  .select("*")
  .eq("id", id)
  .single();

if (error || !moduleData) {
  return Astro.redirect("/admin/modules");
}
---

<AdminLayout title="Edit Module">
  <section class="module-page-header">
    <div>
      <span class="page-eyebrow"> Content </span>

      <h1>Edit Learning Module</h1>

      <p>
        Perbarui materi pembelajaran, video, kategori, group, dan informasi
        modul.
      </p>
    </div>

    <a href="/admin/modules" class="back-link"> ← Back to Modules </a>
  </section>

  <div class="admin-card form-card">
    <form id="module-form">
      <input type="hidden" id="id" value={moduleData.id} />

      <div class="form-grid">
        <!-- TITLE -->
        <div class="form-group form-group-full">
          <label for="title" class="form-label"> Title </label>

          <input
            id="title"
            name="title"
            type="text"
            class="form-control"
            value={moduleData.title ?? ""}
            placeholder="Contoh: Pengertian Zakat"
            required
          />

          <span class="form-help">
            Judul materi yang akan ditampilkan kepada siswa.
          </span>
        </div>

        <!-- CATEGORY -->
        <div class="form-group">
          <label for="category" class="form-label"> Category </label>

          <input
            id="category"
            name="category"
            type="text"
            class="form-control"
            value={moduleData.category ?? ""}
            placeholder="Contoh: PAI"
          />

          <span class="form-help">
            Digunakan sebagai mata pelajaran atau kategori utama.
          </span>
        </div>

        <!-- GROUP NAME -->
        <div class="form-group">
          <label for="group_name" class="form-label"> Group Name </label>

          <input
            id="group_name"
            name="group_name"
            type="text"
            class="form-control"
            value={moduleData.group_name ?? ""}
            placeholder="Contoh: Zakat dan Riba"
          />

          <span class="form-help">
            Digunakan untuk mengelompokkan beberapa materi dalam satu topik.
          </span>
        </div>

        <!-- SORT ORDER -->
        <div class="form-group form-group-full">
          <label for="sort_order" class="form-label"> Sort Order </label>

          <input
            id="sort_order"
            name="sort_order"
            type="number"
            class="form-control sort-control"
            value={moduleData.sort_order ?? 0}
            min="0"
          />

          <span class="form-help">
            Menentukan urutan materi di dalam group.
          </span>
        </div>

        <!-- YOUTUBE -->
        <div class="form-group form-group-full">
          <label for="youtube_url" class="form-label"> YouTube URL </label>

          <input
            id="youtube_url"
            name="youtube_url"
            type="url"
            class="form-control"
            value={moduleData.youtube_url ?? ""}
            placeholder="https://www.youtube.com/watch?v=..."
            required
          />

          <span class="form-help">
            Mendukung URL YouTube biasa, youtu.be, Shorts, dan embed.
          </span>
        </div>

        <!-- DESCRIPTION -->
        <div class="form-group form-group-full">
          <label for="description" class="form-label"> Description </label>

          <textarea
            id="description"
            name="description"
            class="form-control"
            rows="5"
            placeholder="Tuliskan deskripsi singkat materi pembelajaran..."
            >{moduleData.description ?? ""}</textarea
          >

          <span class="form-help">
            Ringkasan singkat yang ditampilkan di halaman daftar dan bagian atas
            detail materi.
          </span>
        </div>

        <!-- CONTENT -->
        <div class="form-group form-group-full">
          <label for="content" class="form-label"> Content </label>

          <textarea
            id="content"
            name="content"
            class="form-control content-control"
            rows="14"
            placeholder="Tuliskan materi pembelajaran lengkap di sini..."
            >{moduleData.content ?? ""}</textarea
          >

          <span class="form-help">
            Materi lengkap yang akan ditampilkan di bawah video pembelajaran.
          </span>
        </div>

        <!-- PUBLISHED -->
        <div class="form-group form-group-full">
          <label class="publish-option">
            <input
              id="is_published"
              name="is_published"
              type="checkbox"
              checked={moduleData.is_published ?? false}
            />

            <span class="publish-control">
              <span class="publish-title"> Published </span>

              <span class="publish-description">
                Materi akan ditampilkan kepada siswa jika status ini aktif.
              </span>
            </span>
          </label>
        </div>
      </div>

      <div class="form-footer">
        <p id="message" class="form-message" aria-live="polite"></p>

        <div class="form-actions">
          <a href="/admin/modules" class="btn btn-secondary"> Cancel </a>

          <button id="submit-button" type="submit" class="btn btn-primary">
            Save Changes
          </button>
        </div>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { supabase } from "../../../../lib/supabase";

  const form = document.getElementById("module-form");

  const message = document.getElementById("message");

  const submitButton = document.getElementById("submit-button");

  function generateSlug(title: string) {
    return title
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-");
  }

  form?.addEventListener("submit", async event => {
    event.preventDefault();

    const id = document.getElementById("id");

    const title = document.getElementById("title");

    const category = document.getElementById("category");

    const groupName = document.getElementById("group_name");

    const description = document.getElementById("description");

    const content = document.getElementById("content");

    const youtubeUrl = document.getElementById("youtube_url");

    const sortOrder = document.getElementById("sort_order");

    const isPublished = document.getElementById("is_published");

    if (
      !(id instanceof HTMLInputElement) ||
      !(title instanceof HTMLInputElement) ||
      !(category instanceof HTMLInputElement) ||
      !(groupName instanceof HTMLInputElement) ||
      !(description instanceof HTMLTextAreaElement) ||
      !(content instanceof HTMLTextAreaElement) ||
      !(youtubeUrl instanceof HTMLInputElement) ||
      !(sortOrder instanceof HTMLInputElement) ||
      !(isPublished instanceof HTMLInputElement)
    ) {
      return;
    }

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;

      submitButton.textContent = "Saving...";
    }

    if (message) {
      message.textContent = "Saving changes...";

      message.className = "form-message";
    }

    const slug = generateSlug(title.value);

    const { error } = await supabase
      .from("modules")
      .update({
        title: title.value.trim(),

        slug,

        category: category.value.trim() || null,

        group_name: groupName.value.trim() || null,

        description: description.value.trim() || null,

        content: content.value.trim() || null,

        youtube_url: youtubeUrl.value.trim(),

        sort_order: Number(sortOrder.value || 0),

        is_published: isPublished.checked,

        updated_at: new Date().toISOString(),
      })
      .eq("id", id.value);

    if (error) {
      if (message) {
        message.textContent = error.message;

        message.className = "form-message error";
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;

        submitButton.textContent = "Save Changes";
      }

      return;
    }

    if (message) {
      message.textContent = "Module updated successfully.";

      message.className = "form-message success";
    }

    window.location.href = "/admin/modules";
  });
</script>

<style>
  /* =========================
     PAGE HEADER
  ========================= */

  .module-page-header {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;

    margin-bottom: 24px;
  }

  .page-eyebrow {
    display: block;

    margin-bottom: 7px;

    color: #9ca3af;

    font-size: 11px;
    font-weight: 600;

    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .module-page-header h1 {
    margin: 0;

    color: #111827;

    font-size: 24px;
    font-weight: 700;

    letter-spacing: -0.02em;
  }

  .module-page-header p {
    margin: 7px 0 0;

    color: #6b7280;

    font-size: 13px;
    line-height: 1.6;
  }

  .back-link {
    color: #6b7280;

    font-size: 13px;
    font-weight: 500;

    text-decoration: none;
  }

  .back-link:hover {
    color: #111827;
  }

  /* =========================
     FORM CARD
  ========================= */

  .form-card {
    max-width: 860px;

    padding: 0;

    overflow: hidden;
  }

  #module-form {
    padding: 28px;
  }

  /* =========================
     FORM GRID
  ========================= */

  .form-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 22px 20px;
  }

  .form-group {
    margin: 0;
  }

  .form-group-full {
    grid-column: 1 / -1;
  }

  .form-label {
    display: block;

    margin-bottom: 8px;

    color: #374151;

    font-size: 13px;
    font-weight: 600;
  }

  .form-control {
    width: 100%;

    padding: 11px 13px;

    border: 1px solid #d1d5db;

    border-radius: 8px;

    background: #fff;

    color: #111827;

    font-size: 14px;
    line-height: 1.5;

    outline: none;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .form-control::placeholder {
    color: #9ca3af;
  }

  .form-control:focus {
    border-color: #2563eb;

    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  textarea.form-control {
    min-height: 135px;

    resize: vertical;
  }

  .sort-control {
    max-width: 180px;
  }

  .content-control {
    min-height: 360px;

    padding: 16px;

    font-size: 14px;
    line-height: 1.8;

    resize: vertical;
  }

  .form-help {
    display: block;

    margin-top: 6px;

    color: #9ca3af;

    font-size: 11px;
    line-height: 1.5;
  }

  /* =========================
     PUBLISHED
  ========================= */

  .publish-option {
    display: flex;

    align-items: flex-start;

    gap: 11px;

    padding: 16px;

    border: 1px solid #e5e7eb;

    border-radius: 9px;

    background: #fafafa;

    cursor: pointer;
  }

  .publish-option input {
    width: 16px;
    height: 16px;

    margin-top: 2px;

    accent-color: #2563eb;
  }

  .publish-control {
    display: flex;

    flex-direction: column;

    gap: 3px;
  }

  .publish-title {
    color: #111827;

    font-size: 13px;
    font-weight: 600;
  }

  .publish-description {
    color: #9ca3af;

    font-size: 12px;
    line-height: 1.5;
  }

  /* =========================
     FOOTER
  ========================= */

  .form-footer {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-top: 28px;
    padding-top: 22px;

    border-top: 1px solid #e5e7eb;
  }

  .form-actions {
    display: flex;

    align-items: center;

    gap: 10px;

    margin: 0;
  }

  .form-message {
    margin: 0;

    color: #6b7280;

    font-size: 12px;
  }

  .form-message.error {
    color: #b91c1c;
  }

  .form-message.success {
    color: #15803d;
  }

  #submit-button:disabled {
    opacity: 0.6;

    cursor: not-allowed;
  }

  /* =========================
     RESPONSIVE
  ========================= */

  :global([data-theme="dark"]) .module-page-header h1,
  :global([data-theme="dark"]) .form-label,
  :global([data-theme="dark"]) .publish-title {
    color: var(--admin-text);
  }

  :global([data-theme="dark"]) .module-page-header p,
  :global([data-theme="dark"]) .back-link,
  :global([data-theme="dark"]) .form-help,
  :global([data-theme="dark"]) .publish-description,
  :global([data-theme="dark"]) .form-message {
    color: var(--admin-muted);
  }

  :global([data-theme="dark"]) .form-control,
  :global([data-theme="dark"]) .publish-option {
    border-color: var(--admin-border);
    background: var(--admin-surface-muted);
    color: var(--admin-text);
  }

  :global([data-theme="dark"]) .form-footer {
    border-color: var(--admin-border);
  }

  @media (max-width: 800px) {
    .module-page-header {
      align-items: flex-start;

      flex-direction: column;

      gap: 14px;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }

    .form-group-full {
      grid-column: auto;
    }

    .sort-control {
      max-width: none;
    }
  }

  @media (max-width: 600px) {
    #module-form {
      padding: 20px;
    }

    .form-footer {
      align-items: stretch;

      flex-direction: column;
    }

    .form-actions {
      width: 100%;
    }

    .form-actions .btn {
      flex: 1;
    }

    .content-control {
      min-height: 280px;
    }
  }
</style>
